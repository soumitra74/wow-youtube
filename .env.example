ANTHROPIC_API_KEY=

CLAUDE_SUMMARIZE_MODEL=claude-haiku-4-5
CLAUDE_ASK_MODEL=claude-sonnet-4-5

CHROMA_COLLECTION=youtube_summaries
EMBEDDING_MODEL=all-MiniLM-L6-v2

TRANSCRIPT_MAX_CHARS=80000
GENERATE_MISSING_TRANSCRIPTS=true
# Pause between YouTube caption/metadata requests (0 disables). Raise to 8–12 if you see HTTP 429.
CAPTION_REQUEST_DELAY_SECONDS=3
CAPTION_RATE_LIMIT_RETRIES=3
CAPTION_RATE_LIMIT_BACKOFF_SECONDS=15
WHISPER_MODEL=base
WHISPER_MAX_MINUTES=90
# Whisper splits audio longer than this into sequential shards
WHISPER_SHARD_MINUTES=10
WHISPER_SHARD_OVERLAP_SECONDS=5
SEMANTIC_TOP_K=8

# Reload CTA: max new videos to summarize per run (0 = unlimited)
YOUTUBE_NOTIFICATIONS_LIMIT=10
# Inbox rows to scan (unprocessed items are often below the newest already-archived)
YOUTUBE_NOTIFICATIONS_SCAN_LIMIT=40
# Include Watch Later (playlist WL) in the reload / fetch-latest scan
YOUTUBE_FETCH_WATCH_LATER=true
YOUTUBE_WATCH_LATER_SCAN_LIMIT=40
YOUTUBE_PLAYLIST_SCAN_LIMIT=40
# Optional extra playlists (comma-separated IDs, not including WL)
YOUTUBE_EXTRA_PLAYLIST_IDS=
# Netscape cookies.txt for youtube.com. Must include LOGIN_INFO plus SAPISID or
# __Secure-3PAPISID. Export from a private window: sign in at youtube.com, open
# https://www.youtube.com/robots.txt in that same tab, then export cookies and
# close the window so YouTube does not rotate the session.
YOUTUBE_COOKIES_PATH=config/youtube_cookies.txt

# Scheduled polls: stop after this many new videos (0 = unlimited)
POLL_LIMIT=10
# Ignore RSS items older than this (0 = no age filter)
POLL_MAX_AGE_DAYS=3
