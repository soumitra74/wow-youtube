#!/bin/sh
# Block commits if unit tests fail. Browser e2e tests run on pre-push.
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv is required to run unit tests" >&2
  exit 1
fi
echo "pre-commit: running unit tests"
uv run pytest tests --ignore=tests/e2e
